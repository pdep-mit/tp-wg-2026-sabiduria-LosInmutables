import wollok.game.*
import partida.*

program CuatroEnLinea {
	game.title("Grupo: LosInmutables | Cuatro en línea")
	game.width(partida.tablero().columnas())
	game.height(partida.tablero().filas() + 1) // una fila extra arriba: de ahí caen las fichas
	game.boardGround("tablero.png")

	// A, D: desplazar la ficha antes de soltarla
	keyboard.a().onPressDo({ partida.desplazarIzquierda() })
	keyboard.left().onPressDo({ partida.desplazarIzquierda() })
	keyboard.d().onPressDo({ partida.desplazarDerecha()} )
	keyboard.right().onPressDo({ partida.desplazarDerecha() })

	// Enter: soltar la ficha
	keyboard.enter().onPressDo({ partida.soltar() })

	// C, F: elegir la ficha en mano (común o fantasma)
	keyboard.c().onPressDo({ partida.elegirComun() })
	keyboard.f().onPressDo({ partida.elegirFantasma() })

	game.schedule(1, { partida.iniciar() })
	game.start()
}
