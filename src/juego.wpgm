import wollok.game.*
import partida.*
import pantallasYteclados.*

program CuatroEnLinea {
	game.title("Grupo: LosInmutables | Cuatro en línea")
	game.width(partida.tablero().columnas())
	game.height(partida.tablero().filas() + 1) // una fila extra arriba: de ahí caen las fichas

	// Un solo teclado: reenvía cada tecla a la pantalla actual
	teclado.configurar()

	// Parpadeo de la sombra de la ficha fantasma (muestra dónde va a caer)
	//game.onTick(400, "parpadeoSombra", { partida.parpadearSombra() })

	// Arranca en el menú inicial (el fondo lo pone cada pantalla)
	game.schedule(1, { navegador.iniciar() })
	game.start()
}
